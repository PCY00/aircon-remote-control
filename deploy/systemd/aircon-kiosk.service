[Unit]
Description=Air conditioner smart-home Chromium kiosk
Documentation=file:/home/air/aircon-controller/docs/operations/kiosk-display.md
Wants=network-online.target tailscaled.service
After=systemd-user-sessions.service network-online.target tailscaled.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=air
Group=air
SupplementaryGroups=video render input audio
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=AIRCON_PORT=8001
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_CACHE_HOME=/home/air/aircon-controller/runtime/kiosk/cache
ExecStart=/home/air/aircon-controller/scripts/run_kiosk.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/air/aircon-controller/runtime/kiosk
ReadWritePaths=/run/user/1000

[Install]
WantedBy=multi-user.target

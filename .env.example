# Copy this file to .env on each machine and adjust local values.
# Never put passwords, SSH keys, or Tailscale auth keys in this file.
AIRCON_HOST=127.0.0.1
AIRCON_PORT=8001
AIRCON_LOG_LEVEL=INFO
AIRCON_DATA_DIR=runtime
AIRCON_DEVICE_PROFILES_DIR=device_profiles
AIRCON_MAX_UPLOAD_BYTES=10485760
AIRCON_IR_CTL_PATH=ir-ctl
AIRCON_IR_RECEIVER_DEVICE=/dev/lirc0
AIRCON_IR_CAPTURE_TIMEOUT=90
# Keep mock on development PCs. Use ir-ctl on a verified Raspberry Pi sender.
AIRCON_IR_TRANSPORT=mock
AIRCON_IR_TRANSMITTER_DEVICE=/dev/lirc0
AIRCON_IR_SEND_TIMEOUT=5

# Zigbee2MQTT sensor bridge. Keep disabled until the local broker is configured.
AIRCON_MQTT_ENABLED=false
AIRCON_MQTT_HOST=127.0.0.1
AIRCON_MQTT_PORT=1883
AIRCON_MQTT_USERNAME=
AIRCON_MQTT_PASSWORD=
AIRCON_MQTT_BASE_TOPIC=zigbee2mqtt
AIRCON_MQTT_CLIENT_ID=aircon-controller
AIRCON_MQTT_KEEPALIVE_SECONDS=60
